# Site URL for production
# In development, this will default to http://localhost:3000
# In production, set this to your actual domain
NEXT_PUBLIC_SITE_URL=https://sapp.capital
# Acquisition funnel. Keep false until the dedicated Mailchimp welcome is ready.
ACQUISITION_LIVE=false
# Server-only credentials, never NEXT_PUBLIC_ or committed real values.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Replacement homepage and application intake. Uses the existing server-only Mailchimp credentials.
# New contacts get sca-application-funnel-v1, not the legacy walkthrough welcome tag.
# Formspree notifications and automatic template fulfillment are not activated by this flag.
APPLICATION_FUNNEL_LIVE=false
# Disabled until signed Cal webhook and Mailchimp suppression branch are reviewed.
CAL_BOOKING_SUPPRESSION_LIVE=false
CAL_BOOKING_WEBHOOK_SECRET=
CAL_INTRO_EVENT_TYPE_ID=5775130
